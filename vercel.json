// ─── Fetch helpers ─────────────────────────────────────────────────────────────
function makeId(str: string) { return crypto.createHash('md5').update(str).digest('hex').slice(0,12) }

async function fetchRSS(src: NewsSource): Promise<NewsItem[]> {
  if (!src.rssUrl) return []
  const feed = await parser.parseURL(src.rssUrl)
  return (feed.items ?? []).slice(0,8).map(item => ({
    id: makeId(item.link ?? item.title ?? Math.random().toString()),
    title: item.title ?? '',
    excerpt: (item.contentSnippet ?? item.summary ?? '').slice(0,220),
    url: item.link ?? src.url,
    source: src.name, sourceKey: src.key, category: src.category, tag: src.tag,
    publishedAt: item.isoDate ?? new Date().toISOString(),
    fetched_at: new Date().toISOString(),
  }))
}

async function fetchHTML(src: NewsSource): Promise<NewsItem[]> {
  const resp = await AX.get<string>(src.url)
  const $ = cheerio.load(resp.data)
  const items: NewsItem[] = []
  const sel = src.selector!
  $(sel.item).slice(0,8).each((_, el) => {
    const title = $(el).find(sel.title).first().text().trim()
    const href  = $(el).find(sel.link).first().attr('href') ?? ''
    const exc   = sel.excerpt ? $(el).find(sel.excerpt).first().text().trim().slice(0,220) : ''
    if (!title) return
    const url = href.startsWith('http') ? href : src.url.replace(/\/$/, '') + (href.startsWith('/') ? href : '/'+href)
    items.push({ id: makeId(url), title, excerpt: exc, url, source: src.name, sourceKey: src.key,
      category: src.category, tag: src.tag, publishedAt: new Date().toISOString(), fetched_at: new Date().toISOString() })
  })
  return items
}

// ─── Main scraper ──────────────────────────────────────────────────────────────
export async function scrapeAllNews(): Promise<{ total: number; errors: string[] }> {
  const db = await getDb()
  let total = 0
  const errors: string[] = []

  for (const src of NEWS_SOURCES) {
    try {
      const items = src.type === 'rss' ? await fetchRSS(src) : await fetchHTML(src)
      for (const i of items) {
        dbRun(db, `INSERT OR REPLACE INTO news (id,title,excerpt,url,source,source_key,category,tag,published_at,fetched_at)
          VALUES (?,?,?,?,?,?,?,?,?,?)`,
          [i.id, i.title, i.excerpt, i.url, i.source, i.sourceKey, i.category, i.tag, i.publishedAt, i.fetched_at])
        total++
      }
      logScraper(db, src.key, 'ok', items.length)
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err)
      errors.push(`${src.key}: ${msg}`)
      logScraper(db, src.key, 'error', 0, msg)
    }
  }

  // Always seed static if DB empty
  const count = dbAll(db, 'SELECT COUNT(*) as c FROM news')[0]?.c ?? 0
  if (!count) {
    for (const i of STATIC_NEWS) {
      dbRun(db, `INSERT OR IGNORE INTO news (id,title,excerpt,url,source,source_key,category,tag,published_at,fetched_at)
        VALUES (?,?,?,?,?,?,?,?,?,?)`,
        [i.id, i.title, i.excerpt, i.url, i.source, i.sourceKey, i.category, i.tag, i.publishedAt, i.fetched_at])
    }
    total += STATIC_NEWS.length
  }

  saveDb(db)
  return { total, errors }
}

// ─── Read helper ───────────────────────────────────────────────────────────────
export async function getNews(filters: { sourceKey?: string; category?: string; limit?: number } = {}): Promise<NewsItem[]> {
  const db = await getDb()

  // Seed if empty
  const count = dbAll(db, 'SELECT COUNT(*) as c FROM news')[0]?.c ?? 0
  if (!count) {
    for (const i of STATIC_NEWS) {
      dbRun(db, `INSERT OR IGNORE INTO news (id,title,excerpt,url,source,source_key,category,tag,published_at,fetched_at)
        VALUES (?,?,?,?,?,?,?,?,?,?)`,
        [i.id, i.title, i.excerpt, i.url, i.source, i.sourceKey, i.category, i.tag, i.publishedAt, i.fetched_at])
    }
    saveDb(db)
  }

  const params: (string|number)[] = []
  let q = 'SELECT * FROM news WHERE 1=1'
  if (filters.sourceKey) { q += ' AND source_key=?'; params.push(filters.sourceKey) }
  if (filters.category)  { q += ' AND category LIKE ?'; params.push(`%${filters.category}%`) }
  q += ' ORDER BY published_at DESC LIMIT ?'
  params.push(filters.limit ?? 50)

  return dbAll(db, q, params).map(r => ({
    id: String(r.id), title: String(r.title), excerpt: String(r.excerpt ?? ''),
    url: String(r.url), source: String(r.source), sourceKey: String(r.source_key),
    category: String(r.category), tag: String(r.tag ?? ''),
    publishedAt: String(r.published_at), fetched_at: String(r.fetched_at),
  }))
}
